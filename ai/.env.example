# Runtime AI configuration. Edit ai/.env and recreate only the AI container.
LLM_MODE=real

# Supported: gemini, openai-compatible
AI_PROVIDER=gemini

# Put the current provider's API key here. Never commit ai/.env.
AI_API_KEY=

# Provider-specific model name.
AI_MODEL=gemini-3.8-flash

# Required for openai-compatible providers. Leave blank for Gemini.
# Examples:
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
AI_BASE_URL=

AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=0
AI_THINKING_LEVEL=low
AI_PORT=8000

# Backward-compatible Gemini aliases (optional; AI_API_KEY/AI_MODEL take precedence).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
